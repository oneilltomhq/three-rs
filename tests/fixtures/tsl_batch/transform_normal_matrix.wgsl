	output.color = vec4<f32>( ( ( normalize( ( transpose( tsl_inverse_mat3( mat3x3<f32>( object.nodeUniform0[ 0 ].xyz, object.nodeUniform0[ 1 ].xyz, object.nodeUniform0[ 2 ].xyz ) ) ) * vec3<f32>( nodeVarying4, 1.0 ) ) ) + normalize( ( transpose( tsl_inverse_mat3( mat3x3<f32>( render.cameraViewMatrix[ 0 ].xyz, render.cameraViewMatrix[ 1 ].xyz, render.cameraViewMatrix[ 2 ].xyz ) ) ) * vec3<f32>( nodeVarying4.y, nodeVarying4.x, 1.0 ) ) ) ) + normalize( ( transpose( tsl_inverse_mat3( object.nodeUniform2 ) ) * vec3<f32>( nodeVarying4.x, 1.0, nodeVarying4.y ) ) ) ), 1.0 );

	return output;

